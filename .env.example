# ===========================================
# Supabase Configuration
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Required for account deletion (/api/account/delete).
# NEVER prefix this with NEXT_PUBLIC_ — it would be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# App Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=IdeaBoard

# ===========================================
# Rate limiting (Upstash Redis)
# ===========================================
# Optional but recommended. Without these, rate limiting silently no-ops
# (fails open) rather than breaking the app. Get these from your Upstash
# database's "REST API" tab — NOT the redis:// connection string.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# Feature Flags
# ===========================================
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_SENTRY=false
